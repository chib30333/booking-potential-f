import { request } from "../lib/http";
import type {
  PaginatedResponse,
  PublicServiceCardDto,
  PublicServiceDetailDto,
  PublicSlotDto,
} from "../types/api";

export interface ListPublicServicesParams {
  city?: string;
  category?: string;
  emotion?: string;
  search?: string;
  limit?: number;
  page?: number;
}

export function listPublicServices(params: ListPublicServicesParams = {}) {
  const search = new URLSearchParams();
  if (params.city) search.set("city", params.city);
  if (params.category) search.set("category", params.category);
  if (params.emotion) search.set("emotion", params.emotion);
  if (params.search) search.set("search", params.search);
  search.set("limit", String(params.limit ?? 24));
  if (params.page) search.set("page", String(params.page));

  return request<PaginatedResponse<PublicServiceCardDto>>(
    `/services?${search.toString()}`
  );
}

export function getPublicServiceBySlug(slug: string) {
  return request<{ data: PublicServiceDetailDto } | PublicServiceDetailDto>(
    `/services/${encodeURIComponent(slug)}`
  ).then((res) =>
    "data" in res ? (res as { data: PublicServiceDetailDto }).data : (res as PublicServiceDetailDto)
  );
}

export interface ListPublicSlotsParams {
  fromDate?: string;
  toDate?: string;
}

export function listPublicSlotsForService(
  serviceId: string,
  params: ListPublicSlotsParams = {}
) {
  const search = new URLSearchParams();
  if (params.fromDate) search.set("fromDate", params.fromDate);
  if (params.toDate) search.set("toDate", params.toDate);
  const query = search.toString();
  return request<{ success: boolean; data: PublicSlotDto[] }>(
    `/services/${encodeURIComponent(serviceId)}/slots${query ? `?${query}` : ""}`
  ).then((res) => res.data);
}
